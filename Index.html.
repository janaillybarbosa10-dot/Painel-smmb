<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Painel SMMB</title>
<style>
*{box-sizing:border-box}
body{
margin:0;
font-family:Arial,sans-serif;
background:#080d18;
color:white;
}
header{
background:#101d35;
padding:25px;
text-align:center;
border-bottom:2px solid #168cff;
}
header h1{color:#168cff;margin:0}
header p{color:#bbb}
.container{padding:20px;max-width:650px;margin:auto}
.card{
background:#111d31;
padding:20px;
border-radius:12px;
margin:15px 0;
border:1px solid #203b60;
}
h2{color:#168cff}
input,select{
width:100%;
padding:13px;
margin:8px 0;
border-radius:7px;
border:1px solid #168cff;
background:#080d18;
color:white;
}
button{
width:100%;
padding:14px;
background:#087cf0;
border:0;
border-radius:7px;
color:white;
font-weight:bold;
}
footer{text-align:center;padding:25px;color:#888}
</style>
</head>
<body>
<header>
<h1>Painel SMMB</h1>
<p>Seu painel de serviços digitais</p>
</header>

<div class="container">
<div class="card">
<h2>Bem-vindo ao SMMB!</h2>
<p>Escolha seu serviço digital.</p>
</div>

<div class="card">
<h2>Fazer pedido</h2>
<form onsubmit="alert('Demonstração: o pedido ainda não foi enviado.');return false;">
<label>Seu nome</label>
<input type="text" placeholder="Digite seu nome" required>

<label>Serviço</label>
<select required>
<option value="">Escolha um serviço</option>
<option>Seguidores</option>
<option>Curtidas</option>
<option>Visualizações</option>
</select>

<label>Link do perfil</label>
<input type="url" placeholder="Cole o link do perfil" required>

<label>Quantidade</label>
<input type="number" min="1" placeholder="Quantidade" required>

<button type="submit">Enviar pedido</button>
</form>
</div>
</div>

<footer>© 2026 Painel SMMB</footer>
</body>
</html>
